---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PublicLinks from "@/components/PublicLinks.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import ContentCategoryGrid from "@/components/ContentCategoryGrid.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getCategoryCounts from "@/utils/getCategoryCounts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { PUBLIC_LINKS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const categoryCounts = getCategoryCounts(sortedPosts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        图书馆
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="订阅 RSS"
        title="订阅 RSS"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">订阅 RSS</span>
      </a>

      <p class="max-w-2xl leading-7">
        你好，我是往目琛。这里是“私立直江津高校”的图书馆，用来整理和分享我的学习、
        游戏、生活记录以及个人文章。
      </p>
      {
        PUBLIC_LINKS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">公开链接：</div>
            <PublicLinks />
          </div>
        )
      }
    </section>

    <Hr />

    <section
      id="content-categories"
      class="py-10"
      aria-labelledby="categories-title"
    >
      <div class="mb-6">
        <h2 id="categories-title" class="text-2xl font-semibold tracking-wide">
          内容栏目
        </h2>
        <p class="mt-2 leading-7 opacity-80">
          从学习、游戏、WOTA艺和动漫四个方向浏览记录。
        </p>
      </div>
      <ContentCategoryGrid counts={categoryCounts} />
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">精选文章</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">最近更新</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        查看全部文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
