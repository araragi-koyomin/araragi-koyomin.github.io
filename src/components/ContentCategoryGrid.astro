---
import { CONTENT_CATEGORIES } from "@/constants/content";
import type { CategoryCounts } from "@/utils/getCategoryCounts";

export interface Props {
  counts?: Partial<CategoryCounts>;
}

const { counts = {} } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    CONTENT_CATEGORIES.map(category => {
      const count = counts[category.key] ?? 0;

      return (
        <li>
          <a
            href={category.href}
            class="group flex h-full min-h-36 flex-col rounded-xl border border-border bg-background p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-md motion-reduce:transform-none motion-reduce:transition-none"
          >
            <span class="text-xl font-semibold text-accent group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4">
              {category.label}
            </span>
            <span class="mt-2 grow text-sm leading-6 opacity-85">
              {category.shortDescription}
            </span>
            <span class="mt-4 text-sm font-medium opacity-70">
              {count > 0 ? `${count} 篇文章` : "等待第一篇记录"}
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
