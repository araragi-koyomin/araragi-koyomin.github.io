---
import type { CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";
import { WOTA_INTRO_PARAGRAPHS, WOTA_SECTIONS } from "@/constants/wota";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  WOTA_INTRO_PARAGRAPHS.length > 0 && (
    <section
      aria-labelledby="wota-intro-title"
      class="mx-0 mb-8 max-w-none rounded-2xl bg-muted/30 px-5 py-6"
    >
      <h2 id="wota-intro-title" class="text-xl font-semibold">
        总结
      </h2>
      <div class="mt-3 space-y-3 leading-7">
        {WOTA_INTRO_PARAGRAPHS.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>
  )
}

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    WOTA_SECTIONS.map(section => {
      const sectionPosts = posts.filter(
        post => post.data.wotaSection === section.key
      );
      const titleId = `wota-${section.key}-title`;

      return (
        <section
          id={section.key}
          aria-labelledby={titleId}
          class="mx-0 max-w-none rounded-2xl border border-border px-4 py-5"
        >
          <div class="flex items-baseline justify-between gap-3">
            <h2 id={titleId} class="text-lg font-semibold">
              {section.label}
            </h2>
            <span
              class="shrink-0 text-sm opacity-70"
              aria-label={`${sectionPosts.length} 篇文章`}
            >
              {sectionPosts.length} 篇
            </span>
          </div>
          {sectionPosts.length > 0 ? (
            <ul class="mt-2 divide-y divide-border">
              {sectionPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          ) : (
            <p class="mt-5 text-sm leading-6 opacity-70">暂无公开内容。</p>
          )}
        </section>
      );
    })
  }
</div>
