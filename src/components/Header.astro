---
import Hr from "./Hr.astro";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { SITE_NAV_ITEMS } from "@/constants/navigation";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header class="w-full">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    跳到主要内容
  </a>
  <div id="nav-container" class="mx-auto max-w-shell px-4">
    <div
      id="top-nav-wrap"
      class="flex w-full flex-col gap-3 bg-background py-4 sm:flex-row sm:items-center sm:justify-between sm:py-6"
    >
      <a
        href="/"
        class="w-fit py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
        aria-label={`${SITE.title}，返回首页`}
      >
        {SITE.title}
      </a>
      <nav id="nav-menu" class="w-full sm:w-auto" aria-label="主导航">
        <ul
          id="menu-items"
          class="flex flex-wrap items-center gap-1 sm:justify-end sm:gap-2"
        >
          {
            SITE_NAV_ITEMS.map(item => {
              const active = isActive(item.href);

              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-11 items-center px-3 py-2 font-medium hover:text-accent sm:min-h-9 sm:px-2 sm:py-1",
                      { "active-nav text-accent": active },
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
          <li class="flex items-center">
            <LinkButton
              href="/search/"
              class:list={[
                "focus-outline flex size-11 items-center justify-center rounded-md sm:size-9",
                { "active-nav text-accent": isActive("/search/") },
              ]}
              ariaLabel="搜索文章"
              title="搜索文章"
            >
              <IconSearch aria-hidden="true" />
              <span class="sr-only">搜索文章</span>
            </LinkButton>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="flex items-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-11 rounded-md p-3 sm:size-9 sm:p-2 hover:[&>svg]:stroke-accent"
                  title="切换显示模式"
                  aria-label="切换显示模式"
                  aria-live="polite"
                >
                  <IconMoon
                    aria-hidden="true"
                    class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all motion-reduce:transition-none dark:scale-0 dark:-rotate-90"
                  />
                  <IconSunHigh
                    aria-hidden="true"
                    class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all motion-reduce:transition-none dark:scale-100 dark:rotate-0"
                  />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr width="shell" />
</header>
