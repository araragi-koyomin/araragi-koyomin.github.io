---
import { PATH_LABELS } from "@/constants/navigation";

export interface Props {
  width?: "reading" | "wide";
}

const { width = "reading" } = Astro.props;
const segments = Astro.url.pathname.split("/").filter(Boolean);
const crumbs = segments.map((segment, index) => {
  const decodedSegment = decodeURIComponent(segment);
  const isPageNumber = /^\d+$/.test(segment);
  const isArchiveYear =
    segments[index - 1] === "archive" && /^\d{4}$/.test(segment);
  const label = isArchiveYear
    ? `${segment}年`
    : isPageNumber
      ? `第 ${segment} 页`
      : PATH_LABELS[segment] || decodedSegment;

  return {
    href: `/${segments.slice(0, index + 1).join("/")}/`,
    label,
    isCurrent: index === segments.length - 1,
  };
});
---

{
  crumbs.length > 0 && (
    <nav
      class:list={[
        "mx-auto mt-8 mb-2 w-full px-4",
        width === "wide" ? "max-w-shell" : "max-w-app",
      ]}
      aria-label="面包屑"
    >
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm opacity-85">
        <li>
          <a
            href="/"
            class="underline-offset-4 hover:text-accent hover:underline"
          >
            首页
          </a>
        </li>
        {crumbs.map(crumb => (
          <li class="flex items-center gap-x-2">
            <span aria-hidden="true">/</span>
            {crumb.isCurrent ? (
              <span aria-current="page" class="font-medium text-foreground">
                {crumb.label}
              </span>
            ) : (
              <a
                href={crumb.href}
                class="underline-offset-4 hover:text-accent hover:underline"
              >
                {crumb.label}
              </a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
