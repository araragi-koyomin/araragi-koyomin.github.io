---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import { CELESTE_MAP_SUMMARY_PATH } from "@/constants/celeste";

export interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<section aria-labelledby="game-posts-title" class="mx-0 max-w-none px-0">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="game-posts-title" class="text-xl font-semibold">栏目文章</h2>
    <p class="text-sm opacity-70">
      共 {posts.length} 篇文章，汇总入口固定置顶
    </p>
  </div>

  <ul class="divide-y divide-border">
    <li class="py-6">
      <article class="rounded-2xl border border-accent/45 bg-accent/5 p-5">
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="rounded-full border border-accent/50 px-2.5 py-1 text-xs font-semibold text-accent"
          >
            固定汇总
          </span>
          <span class="text-sm opacity-70">Celeste</span>
        </div>
        <h3 class="mt-3 text-lg font-semibold">
          <a
            href={CELESTE_MAP_SUMMARY_PATH}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            Celeste 地图汇总
          </a>
        </h3>
        <p class="mt-2 leading-7 opacity-90">
          按合集、难度、主要玩法和个人评分浏览已游玩的地图，并进入单张地图的详细评价。
        </p>
      </article>
    </li>
    {posts.map(post => <Card variant="h3" {...post} />)}
  </ul>

  {
    posts.length === 0 && (
      <p class="rounded-xl border border-dashed border-border px-5 py-6 leading-7 opacity-80">
        普通游戏文章仍在整理；你可以先进入上方的 Celeste 地图汇总查看页面结构。
      </p>
    )
  }
</section>
