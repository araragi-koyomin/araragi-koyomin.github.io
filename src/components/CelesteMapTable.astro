---
import type { CelesteMapSummaryItem } from "@/constants/celeste";
import CelesteCollectionBadge from "./CelesteCollectionBadge.astro";

export interface Props {
  maps: CelesteMapSummaryItem[];
}

const { maps } = Astro.props;
const usedCollections = Array.from(
  new Map(maps.map(map => [map.collection.id, map.collection])).values()
).sort((a, b) => a.name.localeCompare(b.name, "zh-CN"));
const hasMaps = maps.length > 0;

const searchableText = (map: CelesteMapSummaryItem) =>
  [
    map.title,
    map.collection.name,
    map.difficulty,
    map.gameplay,
    map.description,
  ]
    .join(" ")
    .normalize("NFKC")
    .toLocaleLowerCase("zh-CN");
---

<section
  aria-labelledby="celeste-map-list-title"
  class="mx-0 max-w-none px-0"
  data-celeste-map-list
>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="celeste-map-list-title" class="text-xl font-semibold">
        地图列表
      </h2>
      <p class="mt-1 text-sm leading-6 opacity-75">
        地图名可进入对应的详细游玩评价。
      </p>
    </div>
    <p
      class="text-sm font-medium"
      role="status"
      aria-live="polite"
      data-result-status
    >
      {
        hasMaps
          ? `显示 ${maps.length} / ${maps.length} 张地图`
          : "暂时没有地图记录"
      }
    </p>
  </div>

  <form
    class="mt-5 grid gap-4 rounded-2xl border border-border bg-muted/20 p-4 lg:grid-cols-[minmax(16rem,1fr)_minmax(12rem,0.55fr)_minmax(12rem,0.55fr)]"
    data-map-controls
  >
    <div>
      <label for="celeste-map-search" class="block text-sm font-semibold">
        搜索地图
      </label>
      <input
        id="celeste-map-search"
        name="q"
        type="search"
        placeholder="地图名、合集、难度、玩法或简评"
        disabled={!hasMaps}
        class="mt-2 min-h-11 w-full rounded-lg border border-border bg-background px-3 py-2 text-base placeholder:opacity-60 disabled:cursor-not-allowed disabled:opacity-60"
        data-map-search
      />
    </div>
    <div>
      <label for="celeste-map-collection" class="block text-sm font-semibold">
        地图合集
      </label>
      <select
        id="celeste-map-collection"
        name="collection"
        disabled={!hasMaps}
        class="mt-2 min-h-11 w-full rounded-lg border border-border bg-background px-3 py-2 text-base disabled:cursor-not-allowed disabled:opacity-60"
        data-map-collection
      >
        <option value="">全部合集</option>
        {
          usedCollections.map(collection => (
            <option value={collection.id}>{collection.name}</option>
          ))
        }
      </select>
    </div>
    <div>
      <label for="celeste-map-sort" class="block text-sm font-semibold">
        排序方式
      </label>
      <select
        id="celeste-map-sort"
        name="sort"
        disabled={!hasMaps}
        class="mt-2 min-h-11 w-full rounded-lg border border-border bg-background px-3 py-2 text-base disabled:cursor-not-allowed disabled:opacity-60"
        data-map-sort
      >
        <option value="rating-desc">评分从高到低</option>
        <option value="rating-asc">评分从低到高</option>
        <option value="title-asc">地图名顺序</option>
      </select>
    </div>
  </form>

  <div
    class="mt-6 hidden overflow-hidden rounded-2xl border border-border lg:block"
  >
    <div class="overflow-x-auto">
      <table class="w-full min-w-[64rem] border-collapse text-start text-sm">
        <caption class="sr-only">
          Celeste 地图汇总，可使用表格上方的搜索、合集筛选和排序控件调整结果。
        </caption>
        <thead class="bg-muted/35 text-start">
          <tr>
            <th scope="col" class="w-[17%] px-4 py-3 text-start font-semibold">
              地图名
            </th>
            <th scope="col" class="w-[14%] px-4 py-3 text-start font-semibold">
              地图合集
            </th>
            <th scope="col" class="w-[12%] px-4 py-3 text-start font-semibold">
              地图难度
            </th>
            <th scope="col" class="w-[19%] px-4 py-3 text-start font-semibold">
              主要 Gameplay
            </th>
            <th scope="col" class="w-[11%] px-4 py-3 text-start font-semibold">
              总体评分
            </th>
            <th scope="col" class="w-[27%] px-4 py-3 text-start font-semibold">
              地图简评
            </th>
          </tr>
        </thead>
        <tbody data-map-table-body>
          {
            hasMaps ? (
              maps.map((map, index) => (
                <tr
                  class="border-t border-border align-top"
                  data-map-item
                  data-map-view="table"
                  data-map-id={String(index)}
                  data-map-search-text={searchableText(map)}
                  data-map-collection-id={map.collection.id}
                  data-map-title={map.title}
                  data-map-rating={String(map.rating)}
                >
                  <th scope="row" class="px-4 py-4 text-start font-semibold">
                    <a
                      href={map.href}
                      class="text-accent decoration-dashed underline-offset-4 hover:underline"
                    >
                      {map.title}
                    </a>
                  </th>
                  <td class="px-4 py-4">
                    <CelesteCollectionBadge collection={map.collection} />
                  </td>
                  <td class="px-4 py-4 leading-6">{map.difficulty}</td>
                  <td class="px-4 py-4 leading-6">{map.gameplay}</td>
                  <td class="px-4 py-4 font-semibold tabular-nums">
                    {map.rating.toFixed(1)} / 10
                  </td>
                  <td class="px-4 py-4 leading-6">{map.description}</td>
                </tr>
              ))
            ) : (
              <tr>
                <td
                  colspan="6"
                  class="px-5 py-12 text-center leading-7 opacity-75"
                >
                  还没有公开的 Celeste
                  地图记录。以后发布的地图评价会自动出现在这里。
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </div>

  <ul class="mt-6 grid gap-4 lg:hidden" data-map-card-list>
    {
      hasMaps ? (
        maps.map((map, index) => (
          <li
            class="rounded-2xl border border-border p-5"
            data-map-item
            data-map-view="card"
            data-map-id={String(index)}
            data-map-search-text={searchableText(map)}
            data-map-collection-id={map.collection.id}
            data-map-title={map.title}
            data-map-rating={String(map.rating)}
          >
            <article>
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h3 class="text-lg font-semibold">
                  <a
                    href={map.href}
                    class="text-accent decoration-dashed underline-offset-4 hover:underline"
                  >
                    {map.title}
                  </a>
                </h3>
                <span class="font-semibold tabular-nums">
                  {map.rating.toFixed(1)} / 10
                </span>
              </div>
              <div class="mt-3">
                <CelesteCollectionBadge collection={map.collection} />
              </div>
              <dl class="mt-4 grid gap-3 sm:grid-cols-2">
                <div>
                  <dt class="text-sm font-semibold opacity-70">地图难度</dt>
                  <dd class="mt-1 leading-6">{map.difficulty}</dd>
                </div>
                <div>
                  <dt class="text-sm font-semibold opacity-70">
                    主要 Gameplay
                  </dt>
                  <dd class="mt-1 leading-6">{map.gameplay}</dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="text-sm font-semibold opacity-70">地图简评</dt>
                  <dd class="mt-1 leading-7">{map.description}</dd>
                </div>
              </dl>
            </article>
          </li>
        ))
      ) : (
        <li class="rounded-2xl border border-dashed border-border px-5 py-10 text-center leading-7 opacity-75">
          还没有公开的 Celeste 地图记录。以后发布的地图评价会自动出现在这里。
        </li>
      )
    }
  </ul>

  <div
    class="mt-6 hidden rounded-2xl border border-dashed border-border px-5 py-8 text-center"
    data-map-no-results
  >
    <h3 class="font-semibold">没有符合条件的地图</h3>
    <p class="mt-2 leading-7 opacity-75">
      可以缩短关键词、切换合集或清除筛选。
    </p>
    <button
      type="button"
      class="mt-4 min-h-11 rounded-lg border border-accent px-4 py-2 font-medium text-accent hover:bg-accent hover:text-background"
      data-map-reset
      disabled={!hasMaps}
    >
      清除筛选
    </button>
  </div>
</section>

<script>
  const normalizeSearchText = (value: string) =>
    value.normalize("NFKC").trim().toLocaleLowerCase("zh-CN");

  const initializeMapList = (root: HTMLElement) => {
    if (root.dataset.enhanced === "true") return;
    root.dataset.enhanced = "true";

    const searchInput =
      root.querySelector<HTMLInputElement>("[data-map-search]");
    const collectionSelect = root.querySelector<HTMLSelectElement>(
      "[data-map-collection]"
    );
    const sortSelect = root.querySelector<HTMLSelectElement>("[data-map-sort]");
    const resultStatus = root.querySelector<HTMLElement>(
      "[data-result-status]"
    );
    const noResults = root.querySelector<HTMLElement>("[data-map-no-results]");
    const resetButton =
      root.querySelector<HTMLButtonElement>("[data-map-reset]");
    const tableBody = root.querySelector<HTMLTableSectionElement>(
      "[data-map-table-body]"
    );
    const cardList = root.querySelector<HTMLUListElement>(
      "[data-map-card-list]"
    );
    const tableItems = Array.from(
      root.querySelectorAll<HTMLElement>(
        '[data-map-item][data-map-view="table"]'
      )
    );
    const cardItems = Array.from(
      root.querySelectorAll<HTMLElement>(
        '[data-map-item][data-map-view="card"]'
      )
    );

    if (
      !searchInput ||
      !collectionSelect ||
      !sortSelect ||
      !resultStatus ||
      !noResults ||
      !resetButton ||
      !tableBody ||
      !cardList ||
      tableItems.length === 0
    ) {
      return;
    }

    const collator = new Intl.Collator("zh-CN", {
      numeric: true,
      sensitivity: "base",
    });
    const validSortValues = new Set(["rating-desc", "rating-asc", "title-asc"]);

    const params = new URLSearchParams(window.location.search);
    searchInput.value = params.get("q") ?? "";
    const requestedCollection = params.get("collection") ?? "";
    if (
      Array.from(collectionSelect.options).some(
        option => option.value === requestedCollection
      )
    ) {
      collectionSelect.value = requestedCollection;
    }
    const requestedSort = params.get("sort") ?? "rating-desc";
    if (validSortValues.has(requestedSort)) {
      sortSelect.value = requestedSort;
    }

    const compareItems = (a: HTMLElement, b: HTMLElement) => {
      const titleComparison = collator.compare(
        a.dataset.mapTitle ?? "",
        b.dataset.mapTitle ?? ""
      );
      if (sortSelect.value === "title-asc") return titleComparison;

      const aRating = Number(a.dataset.mapRating ?? 0);
      const bRating = Number(b.dataset.mapRating ?? 0);
      const ratingComparison =
        sortSelect.value === "rating-asc"
          ? aRating - bRating
          : bRating - aRating;
      return ratingComparison || titleComparison;
    };

    const sortItems = (items: HTMLElement[], parent: HTMLElement) => {
      [...items].sort(compareItems).forEach(item => parent.append(item));
    };

    const updateUrl = () => {
      const nextParams = new URLSearchParams();
      const query = searchInput.value.trim();
      if (query) nextParams.set("q", query);
      if (collectionSelect.value) {
        nextParams.set("collection", collectionSelect.value);
      }
      if (sortSelect.value !== "rating-desc") {
        nextParams.set("sort", sortSelect.value);
      }

      const queryString = nextParams.toString();
      window.history.replaceState(
        null,
        "",
        `${window.location.pathname}${queryString ? `?${queryString}` : ""}`
      );
    };

    const applyControls = () => {
      const query = normalizeSearchText(searchInput.value);
      const collection = collectionSelect.value;
      let visibleCount = 0;

      tableItems.forEach(item => {
        const matchesQuery =
          !query || (item.dataset.mapSearchText ?? "").includes(query);
        const matchesCollection =
          !collection || item.dataset.mapCollectionId === collection;
        const isVisible = matchesQuery && matchesCollection;
        item.classList.toggle("hidden", !isVisible);
        if (isVisible) visibleCount += 1;
      });

      cardItems.forEach(item => {
        const matchesQuery =
          !query || (item.dataset.mapSearchText ?? "").includes(query);
        const matchesCollection =
          !collection || item.dataset.mapCollectionId === collection;
        item.classList.toggle("hidden", !(matchesQuery && matchesCollection));
      });

      sortItems(tableItems, tableBody);
      sortItems(cardItems, cardList);
      resultStatus.textContent = `显示 ${visibleCount} / ${tableItems.length} 张地图`;
      noResults.classList.toggle("hidden", visibleCount > 0);
      updateUrl();
    };

    searchInput.addEventListener("input", applyControls);
    collectionSelect.addEventListener("change", applyControls);
    sortSelect.addEventListener("change", applyControls);
    resetButton.addEventListener("click", () => {
      searchInput.value = "";
      collectionSelect.value = "";
      sortSelect.value = "rating-desc";
      applyControls();
      searchInput.focus();
    });
    root
      .querySelector<HTMLFormElement>("[data-map-controls]")
      ?.addEventListener("submit", event => event.preventDefault());

    applyControls();
  };

  const initializeMapLists = () => {
    document
      .querySelectorAll<HTMLElement>("[data-celeste-map-list]")
      .forEach(initializeMapList);
  };

  document.addEventListener("astro:page-load", initializeMapLists);
  initializeMapLists();
</script>
