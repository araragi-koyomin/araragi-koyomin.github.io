---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
  width?: "reading" | "shell";
}

const { noPadding = false, ariaHidden = true, width = "reading" } = Astro.props;
---

<div
  class:list={[
    "mx-auto w-full",
    width === "shell" ? "max-w-shell" : "max-w-app",
    noPadding ? "px-0" : "px-4",
  ]}
>
  <hr class="border-border" aria-hidden={ariaHidden} />
</div>
