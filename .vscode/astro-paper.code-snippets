{
  "博客 Frontmatter": {
    "scope": "markdown",
    "prefix": "frontmatter",
    "body": [
      "---",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND.000$CURRENT_TIMEZONE_OFFSET",
      "title: ${1:文章标题}",
      "draft: ${2|true,false|}",
      "tags:",
      "  - ${3:标签}",
      "category: ${4|learning,games,wota,anime|}",
      "subcategory: ${5:子主题}",
      "contentType: ${6|note,experience,solution,review,summary,work|}",
      "spoiler: ${7|false,true|}",
      "description: ${8:文章摘要}",
      "---"
    ],
    "description": "插入当前网站可用的博客 Frontmatter；WOTA艺文章还需填写 wotaSection。"
  },
  "博客文章框架": {
    "scope": "markdown",
    "prefix": "template",
    "body": [
      "---",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND.000$CURRENT_TIMEZONE_OFFSET",
      "title: ${1:文章标题}",
      "draft: ${2|true,false|}",
      "tags:",
      "  - ${3:标签}",
      "category: ${4|learning,games,wota,anime|}",
      "subcategory: ${5:子主题}",
      "contentType: ${6|note,experience,solution,review,summary,work|}",
      "spoiler: ${7|false,true|}",
      "description: ${8:文章摘要}",
      "---",
      "",
      "## 目录",
      "",
      "## 概述",
      "",
      "## 正文",
      "",
      "## 参考资料"
    ],
    "description": "插入中文博客文章的基础 Frontmatter、目录和正文框架。"
  },
  "代码块": {
    "scope": "markdown",
    "prefix": "codeblock",
    "body": ["```${1|text,typescript,javascript,python,java,cpp,c,json,yaml,bash,powershell|}", "$2", "```"],
    "description": "插入带语言标记的代码块。"
  },
  "行内数学公式": {
    "scope": "markdown",
    "prefix": "math-inline",
    "body": ["\\$${1:公式}\\$"],
    "description": "插入 KaTeX 行内数学公式。"
  },
  "块级数学公式": {
    "scope": "markdown",
    "prefix": "math-block",
    "body": ["\\$\\$", "${1:公式}", "\\$\\$"],
    "description": "插入 KaTeX 块级数学公式。"
  },
  "Markdown 链接": {
    "scope": "markdown",
    "prefix": "md-link",
    "body": ["[${1:显示文字}](${2:网址})"],
    "description": "插入普通来源链接或站内链接。"
  }
}
